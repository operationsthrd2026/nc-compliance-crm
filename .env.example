# ══════════════════════════════════════════════════════════════
#  NC Compliance CRM — Environment Variables
#  1. Copy this file to .env.local  (never commit .env.local)
#  2. Fill in your values below
#  3. Restart the dev server after editing
# ══════════════════════════════════════════════════════════════

# ── Supabase ──────────────────────────────────────────────────
# Dashboard → Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Dashboard → Settings → API → Project API Keys → anon / public
VITE_SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Optional plugin API keys (configure in CRM Admin → Plugins)
# These are ONLY used if you connect the AI Prospect Finder sources.
# Leave blank to use demo mode for those sources.
VITE_APOLLO_KEY=
VITE_HUNTER_KEY=
VITE_ANTHROPIC_KEY=
