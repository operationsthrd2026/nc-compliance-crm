# ══════════════════════════════════════════════════════════════
#  NC Compliance CRM — client environment (browser-visible)
#  Copy to .env.local (git-ignored). Everything prefixed VITE_ is
#  compiled into the public JavaScript bundle, so ONLY put values
#  here that are safe for anyone to see.
# ══════════════════════════════════════════════════════════════

# Supabase → Settings → API → Project URL
VITE_SUPABASE_URL=https://ifpzpepurqlvaixxshzk.supabase.co

# Supabase → Settings → API → anon / public key
# (Safe to expose ONLY because Row Level Security protects every table.
#  NEVER put the service_role key here.)
VITE_SUPABASE_KEY=sb_publishable_XALiB_unMNXScN2vpwHSAg_0AMbd47T

# Third-party keys (Apollo, Hunter, Google Search) are NOT configured here.
# They live server-side: set them in Supabase with
#   supabase secrets set APOLLO_API_KEY=... HUNTER_API_KEY=... GOOGLE_API_KEY=... GOOGLE_CSE_ID=...
# or save them in the CRM under Admin → Plugins (stored in a locked-down table).
