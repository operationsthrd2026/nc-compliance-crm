+
+/* ── buttons ─────────────────────────────────────────────── */
+.nc-btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;font:600 12.5px/1 var(--nc-font);padding:9px 14px;border-radius:var(--nc-r-sm);border:1px solid transparent;cursor:pointer;white-space:nowrap;transition:background .15s var(--nc-ease),border-color .15s,transform .08s,box-shadow .15s,opacity .15s;user-select:none}
