+import test from "node:test"; import assert from "node:assert/strict";
+import { scoreProspect, priorityFromScore, emailKind, SCORING } from "./scoring.js";
+const base = { companyName: "X", vertical: "", orgSize: "", hrPersonListed: "", emailPhone: "", contactName: "", sourceUrl: "", market: "", currentStatus: "NEW" };
+
+test("every point is accounted for by a labelled factor, within each factor's max", () => {
+  const s = scoreProspect({ ...base, vertical: "Home Health / Homecare", orgSize: "50-99", hrPersonListed: "No", contactName: "Jane", emailPhone: "jane@sunrise.org 919-555-0100", sourceUrl: "https://sunrise.org", market: "Raleigh" });
+  assert.equal(s.factors.reduce((a, f) => a + f.points, 0), s.score);
+  s.factors.forEach(f => assert.ok(f.points <= f.max, `${f.key} ${f.points}>${f.max}`));
+  assert.equal(s.tier, "hot"); assert.ok(s.score >= 70 && s.score <= 100);
+});
+test("empty record scores low with a to-do list of what's missing", () => {
+  const s = scoreProspect(base);
+  assert.equal(s.tier, "low"); assert.ok(s.missing.includes("email") && s.missing.includes("organisation size") && s.missing.includes("industry"));
+});
+test("a huge org with an HR contact scores lower than a mid-size one without", () => {
+  const big = scoreProspect({ ...base, vertical: "Healthcare Practices", orgSize: "500+", hrPersonListed: "Yes" });
+  const mid = scoreProspect({ ...base, vertical: "Healthcare Practices", orgSize: "50-99", hrPersonListed: "No" });
+  assert.ok(mid.score > big.score + 20);
+});
+test("Do Not Respond is always excluded (0)", () => {
+  assert.deepEqual([scoreProspect({ ...base, doNotRespond: true }).score, scoreProspect({ ...base, currentStatus: "Do Not Respond" }).tier], [0, "excluded"]);
+});
+test("a failed email gives no email credit; a verified personal email gets the bonus", () => {
+  const e = "jane@sunrise.org";
+  const bad = scoreProspect({ ...base, emailPhone: e, emailStatus: "invalid" }), ok = scoreProspect({ ...base, emailPhone: e }), ver = scoreProspect({ ...base, emailPhone: e, emailStatus: "valid" });
+  assert.equal(bad.factors.find(f => f.key === "reach").points, 0);
+  assert.equal(ver.score - ok.score, SCORING.reach.verifiedBonus);
+});
+test("emailKind", () => { assert.equal(emailKind("info@x.org"), "generic"); assert.equal(emailKind("HR@x.org"), "hr"); assert.equal(emailKind("jane.doe@x.org"), "personal"); });
+test("priorityFromScore maps 0-100 to 1-10", () => { assert.deepEqual([0, 5, 10, 55, 100].map(priorityFromScore), [1, 1, 1, 6, 10]); });
+test("scores never leave 0..100", () => {
+  const max = scoreProspect({ ...base, vertical: "Home Health / Homecare", orgSize: "50-99", hrPersonListed: "No", contactName: "J", emailPhone: "j@x.org 9195550100", emailStatus: "valid", sourceUrl: "x.org", market: "Raleigh", replyReceived: true });
+  assert.ok(max.score <= 100 && max.score >= 90);
+});
+
+import { explainFit } from "./scoring.js";
+test("explainFit gives a short readable reason, and nothing for excluded prospects", () => {
+  const s = scoreProspect({ ...base, vertical: "Home Health / Homecare", orgSize: "50-99", hrPersonListed: "No", emailPhone: "j@x.org", contactName: "J" });
+  const t = explainFit(s); assert.match(t, /^Fit \d+\/100 \((Hot|Strong)\)/); assert.match(t, /Home Health/); assert.match(t, /No HR person listed/);
+  assert.equal(explainFit(scoreProspect({ ...base, doNotRespond: true })), "");
+});
diff --git a/src/lib/text.js b/src/lib/text.js
new file mode 100644
index 0000000..26e0322
--- /dev/null
+++ b/src/lib/text.js
@@ -0,0 +1,104 @@
+/* ════════════════════════════════════════════════════════════════
+   Text normalisation + similarity helpers (pure, no dependencies)
+════════════════════════════════════════════════════════════════ */
+
+// Providers where an email domain says nothing about the organisation.
+export const FREEMAIL = new Set([
+  "gmail.com","googlemail.com","yahoo.com","ymail.com","hotmail.com","outlook.com","live.com","msn.com",
+  "aol.com","icloud.com","me.com","comcast.net","verizon.net","att.net","sbcglobal.net","bellsouth.net",
+  "protonmail.com","proton.me","gmx.com","mail.com","earthlink.net","charter.net","windstream.net",
+]);
+
+// Legal-form / filler words that must not decide whether two names match.
+const NAME_NOISE = new Set([
+  "inc","incorporated","llc","l","c","llp","lp","corp","corporation","co","company","ltd","limited",
+  "pllc","pc","pa","the","of","and","dba",
+]);
+
+export function stripAccents(s){ return String(s ?? "").normalize("NFKD").replace(/[\u0300-\u036f]/g, ""); }
+
+/** "ACME Home-Care, L.L.C." -> "acme home care" */
+export function normalizeName(name){
+  const cleaned = stripAccents(name).toLowerCase()
+    .replace(/&/g, " and ")
+    .replace(/[.'’`]/g, "")          // l.l.c. -> llc, don't -> dont
+    .replace(/[^a-z0-9]+/g, " ")
+    .trim();
+  return cleaned.split(/\s+/).filter(t => t && !NAME_NOISE.has(t)).join(" ");
+}
+
+export function nameTokens(name){ return normalizeName(name).split(" ").filter(Boolean); }
+
+export function bigrams(s){
+  const t = s.replace(/\s+/g, " ");
+  if (t.length < 2) return t ? [t] : [];
+  const out = []; for (let i = 0; i < t.length - 1; i++) out.push(t.slice(i, i + 2));
+  return out;
+}
+
+/** Sørensen–Dice on character bigrams (forgives typos / small word changes). */
+export function dice(a, b){
+  if (!a || !b) return 0;
+  if (a === b) return 1;
+  return diceBigrams(bigrams(a), bigrams(b));
+}
+
+/** Same as dice() but on precomputed bigram arrays (hot path for dedupe). */
+export function diceBigrams(A, B){
+  if (!A.length || !B.length) return 0;
+  const counts = new Map(); for (const g of A) counts.set(g, (counts.get(g) || 0) + 1);
+  let hit = 0; for (const g of B){ const c = counts.get(g); if (c > 0){ hit++; counts.set(g, c - 1); } }
+  return (2 * hit) / (A.length + B.length);
+}
+
+export function jaccard(ta, tb){
+  const A = ta instanceof Set ? ta : new Set(ta), B = tb instanceof Set ? tb : new Set(tb); if (!A.size || !B.size) return 0;
+  let inter = 0; for (const t of A) if (B.has(t)) inter++;
+  return inter / (A.size + B.size - inter);
+}
+
+/** Similarity from precomputed fingerprints {name, set, bg}. */
+export function similarityKeys(ka, kb){
+  if (!ka.name || !kb.name) return 0;
+  if (ka.name === kb.name) return 1;
+  const jac = jaccard(ka.set, kb.set);
+  const dc = diceBigrams(ka.bg, kb.bg);
+  return Math.max(jac * 0.9, dc * 0.5 + jac * 0.5);
+}
+
+/** 0..1 similarity between two organisation names. 1 = same after normalisation. */
+export function nameSimilarity(a, b){
+  const na = normalizeName(a), nb = normalizeName(b);
+  if (!na || !nb) return 0;
+  if (na === nb) return 1;
+  const jac = jaccard(na.split(" "), nb.split(" "));
+  const dc = dice(na, nb);
+  return Math.max(jac * 0.9, dc * 0.5 + jac * 0.5);
+}
+
+export const EMAIL_RE = /[A-Z0-9._%+'-]+@[A-Z0-9.-]+\.[A-Z]{2,}/gi;
+
+export function extractEmails(text){
+  const m = String(text ?? "").match(EMAIL_RE) || [];
+  return [...new Set(m.map(e => e.toLowerCase().replace(/[.,;:]+$/, "")))];
+}
+
+/** Last-10-digit phone numbers found in free text ("(919) 555-0100 / +1 919.555.0101"). */
+export function extractPhones(text){
+  const s = String(text ?? "").replace(/[A-Z0-9._%+'-]+@[A-Z0-9.-]+\.[A-Z]{2,}/gi, " "); // drop emails first
+  const out = new Set();
+  const re = /(?:\+?1[\s.-]*)?\(?\d{3}\)?[\s.-]*\d{3}[\s.-]*\d{4}/g;
+  for (const m of s.match(re) || []){ const d = m.replace(/\D/g, ""); if (d.length >= 10) out.add(d.slice(-10)); }
+  return [...out];
+}
+
+export function domainOfEmail(email){ const m = String(email ?? "").toLowerCase().match(/@([a-z0-9.-]+\.[a-z]{2,})$/); return m ? m[1] : ""; }
+
+/** Registrable-ish domain from a URL or bare host: "https://www.Acme.org/about" -> "acme.org" */
+export function domainOfUrl(url){
+  let s = String(url ?? "").trim().toLowerCase(); if (!s) return "";
+  s = s.replace(/^[a-z]+:\/\//, "").replace(/^www\./, "").split(/[/?#]/)[0].split(":")[0];
+  return /^[a-z0-9.-]+\.[a-z]{2,}$/.test(s) ? s : "";
+}
+
+export const isFreemail = d => FREEMAIL.has(String(d ?? "").toLowerCase());
