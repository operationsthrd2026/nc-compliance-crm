+
+/* ── inputs ──────────────────────────────────────────────── */
+.nc-input,.nc-select,.nc-textarea{width:100%;background:rgba(240,244,255,.05);border:1px solid var(--nc-border-2);color:var(--nc-text);border-radius:var(--nc-r-sm);padding:8px 11px;font:500 13px var(--nc-font);transition:border-color .15s,background .15s,box-shadow .15s}
