+      const n = s => results.filter(x => x.r.status === s).length;
+      toast(`${n("valid")} valid · ${n("risky")} risky · ${n("invalid")} invalid${n("unknown") ? ` · ${n("unknown")} couldn't be checked` : ""}`, n("invalid") || n("unknown") ? "err" : "ok");
