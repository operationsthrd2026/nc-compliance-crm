+/* ════════════════════════════════════════════════════════════════
+   NC Compliance CRM — modern layer (dark + gold brand preserved)
+   Tokens mirror the colours in src/constants.js.
+════════════════════════════════════════════════════════════════ */
+:root{
+  --nc-bg:#0B1426; --nc-surface:#111E38; --nc-surface-2:#162040; --nc-surface-3:#1C2B50;
+  --nc-gold:#C9963A; --nc-gold-l:#DBA843; --nc-gold-a:rgba(201,150,58,.14); --nc-gold-b:rgba(201,150,58,.38);
+  --nc-text:#F0F4FF; --nc-text-2:rgba(240,244,255,.64); --nc-text-3:rgba(240,244,255,.40);
+  --nc-border:rgba(240,244,255,.08); --nc-border-2:rgba(240,244,255,.15);
+  --nc-green:#34d399; --nc-amber:#fbbf24; --nc-red:#f87171; --nc-pink:#f472b6; --nc-blue:#60a5fa; --nc-purple:#c084fc;
+  --nc-r:10px; --nc-r-sm:7px; --nc-r-lg:14px;
+  --nc-shadow:0 12px 40px rgba(0,0,0,.45); --nc-shadow-sm:0 2px 10px rgba(0,0,0,.3);
+  --nc-font:'Inter','Segoe UI',system-ui,-apple-system,'Helvetica Neue',Arial,sans-serif;
+  --nc-ease:cubic-bezier(.4,0,.2,1);
+  --nc-header-h:82px;
+}
+html,body{font-family:var(--nc-font);-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;text-rendering:optimizeLegibility}
+body{font-feature-settings:"cv11","ss01"}
+::selection{background:rgba(201,150,58,.35)}
+*{scrollbar-width:thin;scrollbar-color:rgba(240,244,255,.18) transparent}
+*::-webkit-scrollbar{width:9px;height:9px}
+*::-webkit-scrollbar-thumb{background:rgba(240,244,255,.16);border-radius:9px;border:2px solid transparent;background-clip:content-box}
+*::-webkit-scrollbar-thumb:hover{background:rgba(240,244,255,.28);background-clip:content-box;border:2px solid transparent}
