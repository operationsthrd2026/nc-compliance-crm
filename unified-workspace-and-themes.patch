 .nc-bar>i{display:block;height:100%;border-radius:99px;transition:width .4s var(--nc-ease)}
 
 /* leaflet on dark */
-.nc .leaflet-container{background:#0b1426;font-family:var(--nc-font)}
-.nc .leaflet-popup-content-wrapper,.nc .leaflet-popup-tip{background:#141f3b;color:var(--nc-text);border:1px solid var(--nc-border-2);box-shadow:var(--nc-shadow)}
+.nc .leaflet-container{background:var(--k-bg);font-family:var(--nc-font)}
+.nc .leaflet-popup-content-wrapper,.nc .leaflet-popup-tip{background:var(--k-pop);color:var(--nc-text);border:1px solid var(--nc-border-2);box-shadow:var(--nc-shadow)}
 .nc .leaflet-popup-content{margin:12px 14px;font-size:12px}
 .nc .leaflet-container a.leaflet-popup-close-button{color:var(--nc-text-3)}
-.nc .leaflet-control-attribution{background:rgba(11,20,38,.75)!important;color:var(--nc-text-3)!important}
+.nc .leaflet-control-attribution{background:rgba(var(--k-bg-rgb),.75)!important;color:var(--nc-text-3)!important}
 .nc .leaflet-control-attribution a{color:var(--nc-text-2)!important}
-.nc .leaflet-bar a{background:#141f3b;color:var(--nc-text);border-bottom-color:var(--nc-border)}
-.nc .leaflet-bar a:hover{background:#1c2b50}
+.nc .leaflet-bar a{background:var(--k-pop);color:var(--nc-text);border-bottom-color:var(--nc-border)}
+.nc .leaflet-bar a:hover{background:var(--k-surface3)}
 
 @media (max-width:760px){
   .nc-bulk{bottom:10px;border-radius:12px}
